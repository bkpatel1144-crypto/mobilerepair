rules_version = '2';

// Job Card images are the only Storage use so far (Phase 5). Ideally this would mirror
// firestore.rules' own company-membership check, the way Storage's documented cross-product
// `firestore.get()`/`firestore.exists()` support allows — but that function only reads the
// "(default)" Firestore database, and this project's Firestore is the *named* database "demo"
// (see BUILD_PLAN.md §1), so it can't actually see this project's `users/{uid}` docs at all.
// Rather than ship a company-membership check that would silently pass or fail based on a
// database-name mismatch nobody would notice until it mattered, this settles for
// authenticated-only + effectively-unguessable path segments (random Firestore auto-IDs for
// both `companyId` and `jobId`) — real access control, just coarser than firestore.rules' own.
// Revisit if a future phase's Storage use needs the stronger per-tenant guarantee.
//
// Same not-yet-deployed caveat as firestore.rules — see PROGRESS.md.

service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/jobCards/{jobId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Phase 7 — Second Hand Device Purchase device/ID-proof photos. Same coarser-than-Firestore
    // boundary as jobCards above, same reason (see the file-level comment).
    match /companies/{companyId}/secondHandPurchases/{purchaseId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Phase 10 — Backup & Restore's own JSON snapshots ("Backup Now") and restored-as-archive
    // copies ("Restore from File" → "Restore as Archive"). Same coarser-than-Firestore boundary
    // as above — a whole-tenant data export is genuinely sensitive, but this project has no way
    // to check real company membership from Storage's own rules (see the file-level comment).
    match /companies/{companyId}/backups/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /companies/{companyId}/archives/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
