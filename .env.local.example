# Copy this file to .env.local (gitignored) and fill in real values.
# See BUILD_PLAN.md §1 for why VITE_FIREBASE_DATABASE_ID matters.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Non-default Firestore database name, if your project doesn't use "(default)".
# Leave blank to use the default database.
VITE_FIREBASE_DATABASE_ID=
